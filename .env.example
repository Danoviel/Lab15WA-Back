# Base de datos MySQL (Railway). Usar el host/puerto PÚBLICO (*.proxy.rlwy.net).
DB_HOST=tu-host.proxy.rlwy.net
DB_PORT=00000
DB_NAME=railway
DB_USER=root
DB_PASSWORD=tu_password

# Puerto del servidor (Render asigna PORT automáticamente)
PORT=3001

# Entorno: development | production
NODE_ENV=development

# Secreto para firmar los JWT (debe ser el MISMO valor en el frontend)
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# URL del frontend permitida por CORS (separar por comas si son varias)
FRONTEND_URL=http://localhost:3000
